#!/bin/bash
# Auto-check sprint goals based on commit message content
# Matches issue numbers (#16, #17, etc.) or keywords from goals

SPRINT_FILE=$(ls docs/wiki/Sprint-*.md 2>/dev/null | grep -v "Sprint-Log" | sort -t- -k2 -n | tail -1)
[ -z "$SPRINT_FILE" ] && exit 0

# Only run if source files changed
SRC_CHANGED=$(git diff-tree --no-commit-id --name-only -r HEAD | grep -E "^src/|^tests/" | head -1)
[ -z "$SRC_CHANGED" ] && exit 0

COMMIT_MSG=$(git log -1 --pretty=%B)
CHANGED=false

# Try to match issue numbers in commit message (#16, #22, etc.)
for ISSUE in $(echo "$COMMIT_MSG" | grep -oE '#[0-9]+' | tr -d '#'); do
  if grep -q "\- \[ \].*#${ISSUE}" "$SPRINT_FILE" 2>/dev/null; then
    sed -i "s/- \[ \]\(.*#${ISSUE}\)/- [x]\1/" "$SPRINT_FILE"
    echo "✅ Auto-checked goal matching #${ISSUE} in $SPRINT_FILE"
    CHANGED=true
  fi
done

# If nothing matched by issue number, warn
if [ "$CHANGED" = false ]; then
  UNCHECKED=$(grep -c "\- \[ \]" "$SPRINT_FILE" 2>/dev/null || echo 0)
  if [ "$UNCHECKED" -gt 0 ]; then
    echo ""
    echo "⚠️  $UNCHECKED unchecked goals in $SPRINT_FILE. No issue # matched in commit message."
    echo ""
  fi
fi

# If we changed the sprint file, amend the commit to include it
if [ "$CHANGED" = true ]; then
  git add "$SPRINT_FILE"
  git commit --amend --no-edit --no-verify >/dev/null 2>&1
  echo "📝 Sprint file amended into commit"
fi
