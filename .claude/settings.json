{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/pre-commit-check.sh",
            "statusMessage": "Checking commit hygiene..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'INPUT=$(cat); CMD=$(echo \"$INPUT\" | jq -r \".tool_input.command // empty\"); if echo \"$CMD\" | grep -q \"git push\"; then .claude/hooks/sync-wiki.sh; fi; if echo \"$CMD\" | grep -q \"docker compose up\"; then echo \"🧪 POST-DEPLOY: Run smoke tests! npm run test:smoke\" >&2; fi'",
            "statusMessage": "Post-action checks..."
          }
        ]
      }
    ],
    "TaskCompleted": [
      {
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/sync-wiki.sh",
            "statusMessage": "Syncing wiki..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/sync-wiki.sh",
            "statusMessage": "Final wiki sync..."
          },
          {
            "type": "command",
            "command": "echo '✅ Session complete. Verify: CHANGELOG.md | Sprint-Log.md | Tests | README.md | Issues' >&2"
          }
        ]
      }
    ]
  },
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  }
}
